@incollection{liderfelt2018,
title = {Chapter 23 - Filtration Methods for Use in Purification Processes (Concentration and Buffer Exchange)},
editor = {Günter Jagschies and Eva Lindskog and Karol Łącki and Parrish Galliher},
booktitle = {Biopharmaceutical Processing},
publisher = {Elsevier},
pages = {441-453},
year = {2018},
isbn = {978-0-08-100623-8},
doi = {https://doi.org/10.1016/B978-0-08-100623-8.00023-2},
url = {https://www.sciencedirect.com/science/article/pii/B9780081006238000232},
author = {Jakob Liderfelt and Jonathan Royce},
keywords = {Application areas, CFF, UF/DF, mAb, Critical process parameters},
abstract = {The main goal with an ultrafiltration (UF) and diafiltration (DF) operation is to concentrate the target and change the environment (i.e., buffer), respectively. The concentration is performed in order to minimize the process volumes downstream of the UF/DF step and the buffer exchange is performed to transfer the target environment in order to suit the next downstream unit operation or the longer-term storage of the product being purified. Due to the limited ability of removing impurities (only impurities smaller than the target can be removed) for protein targets, UF/DF is not used specifically as a purification operation. Small proteins and other molecules such as DNA can be removed, but usually not to a greater extent. For processes where the target is large, like viruses, and the membrane cut of is more open, removal of impurities is more effective and UF/DF is used as a purification operation. A typical UF/DF process is described in Fig. 23.1 (adopted from Ref. [1]). The process is based on a concentration and a diafiltration phase. It is also common to continue the concentration after the diafiltration in order to reduce the process volumes and get the highest target concentration possible.}
}

