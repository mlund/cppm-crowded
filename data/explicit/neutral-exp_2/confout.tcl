# Generated by Faunus — run with: vmd -e confout.tcl
mol load psf confout.psf xyz confout.xyz
mol modstyle 0 top VDW 1.0 12.0
mol modcolor 0 top Charge
pbc box
set sel [atomselect top {type MP}]; $sel set radius 20.0000; $sel delete
set sel [atomselect top {type UP}]; $sel set radius 2.0000; $sel delete
set sel [atomselect top {type Na}]; $sel set radius 2.0000; $sel delete
set sel [atomselect top {type Cl}]; $sel set radius 2.0000; $sel delete

# --- Per-frame visibility for speciation/GCMC ---
# Read group layout and per-frame active counts
set group_info {}
set frame_data {}
set _fp [open "confout.sizes.dat" r]
while {[gets $_fp _line] >= 0} {
    set _line [string trim $_line]
    if {$_line eq ""} continue
    if {[regexp {^#\s+(\d+)\s+\S+\s+(\d+)\s+(\d+)} $_line -> _gi _start _cap]} {
        lappend group_info $_start $_cap
    } elseif {![string match {#*} $_line]} {
        lappend frame_data [list {*}$_line]
    }
}
close $_fp

set _all [atomselect top "all"]
set default_radii [$_all get radius]
$_all delete

proc faunus_update_visibility {args} {
    global vmd_frame group_info frame_data default_radii
    set f $vmd_frame(0)
    if {$f >= [llength $frame_data]} return
    set sizes [lindex $frame_data $f]
    set radii $default_radii
    set gi 0
    foreach {start cap} $group_info {
        set active [lindex $sizes $gi]
        for {set i $active} {$i < $cap} {incr i} {
            lset radii [expr {$start + $i}] 0.0
        }
        incr gi
    }
    set _all [atomselect top "all"]
    $_all set radius $radii
    $_all delete
}

if {[llength $frame_data] > 0} {
    trace variable vmd_frame(0) w faunus_update_visibility
    faunus_update_visibility
}
