\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Spatial distribution of salt ions and surface groups of neighboring macro-ions around each CPPM variant, projected onto a Mollweide equal-area map of the unit sphere. Local density $\rho /\rho _\mathrm  {bulk}$ sampled on a spherical shell at fixed center-of-mass separation: $\rho = 1$ (white) = bulk; $\rho > 1$ = enrichment; $\rho < 1$ = depletion. Subpanels: (a)\nobreakspace  {}chloride; (b)\nobreakspace  {}sodium; (c)\nobreakspace  {}NP surface groups; (d)\nobreakspace  {}PP surface groups. The color scale is shared within each variant. (Top) Dipolar $P^{1}_{8}$ at $r = \qty {25}{\angstrom }$. (Bottom) Quadrupolar $P^{2}_{8}$ at $r = \qty {25}{\angstrom }$.}}{8}{}\protected@file@percent }
\newlabel{fig:mw_sdf}{{S4}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Same as Fig.\nobreakspace  {}\ref {fig:mw_sdf} for the remaining variants. (Top) Isotropic $P^{0}_{0}$ at $r = \qty {25}{\angstrom }$. (Bottom) Neutral $P^\mathrm  {n}$ at $r = \qty {23}{\angstrom }$; subpanels (c) and (d) are omitted because surface groups carry no charge.}}{9}{}\protected@file@percent }
\newlabel{fig:mw_sdf_2}{{S5}{9}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Center-of-mass $g(r)$ for the three charged variants over the full $\kappa ^{-1}$ scan from implicit-ion simulations. $P^{0}_{0}$ (dotted), $P^{1}_{8}$ (dashed), $P^{2}_{8}$ (solid). Line color encodes $\kappa ^{-1}$ (rainbow bar: violet = weak screening, large $\kappa ^{-1}$; red = strong screening, small $\kappa ^{-1}$). Black lines: explicit-ion reference. Shaded bands: mean $\pm $ SEM.}}{10}{}\protected@file@percent }
\newlabel{fig:gofr_com}{{S6}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Orientational pair correlations for the three charged variants over the full $\kappa ^{-1}$ scan. (a)\nobreakspace  {}$\langle \hat  {\mu }_i\cdot \hat  {\mu }_j\rangle $; (b)\nobreakspace  {}$\langle (\hat  {\mu }_i\cdot \hat  {r}_{ij})(\hat  {\mu }_j\cdot \hat  {r}_{ij})\rangle $; (c)\nobreakspace  {}$\langle P_2(\cos \theta _{ij})\rangle $; (d)\nobreakspace  {}$\langle \hat  {\mathbf  {Q}}_i{:}\hat  {\mathbf  {Q}}_j\rangle $. Rainbow color bar encodes $\kappa ^{-1}$; black lines: explicit-ion reference; shaded bands: mean $\pm $ SEM.}}{11}{}\protected@file@percent }
\newlabel{fig:mp_corr}{{S7}{11}}
