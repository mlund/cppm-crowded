\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Center-of-mass radial distribution functions $g(r)$ of the CPPM variants: $P^{0}_{0}$ (dotted), $P^{1}_{8}$ (dashed), $P^{2}_{8}$ (solid) and $P^\mathrm  {n}$ (dash-dotted) obtained from explicit-ion simulations at volume fraction of $\phi _\mathrm  {p}= 0.30$ and \ce {NaCl} activity of $a_{\ce {NaCl}}= \qty {100}{mM}$. The orange dash-dotted line shows the Percus--Yevick hard-sphere theory fitted to the $P^\mathrm  {n}$ system (effective diameter $d_{\mathrm  {eff}}= \qty {42.9}{\angstrom }$, $\phi _{\mathrm  {eff}}= 0.37$).}}{11}{}\protected@file@percent }
\newlabel{fig:gofr_exp}{{3}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Spatial distribution of salt ions and surface groups around the CPPM variants: (a) $P^{0}_{0}$, (b) $P^{1}_{8}$, (c) $P^{2}_{8}$ and (d) $P^\mathrm  {n}$. Isosurfaces correspond to normalized local densities of 1.3 (surface groups) and 2.3 (ions) for the charged variants. For the neutral variant, the lower local density of 1.75 (ions) was used to render the more weakly structured distribution. Yellow arrows indicate the position of the center of the positively charged patches. Color coding: gray = center particle, red = positive surface groups, blue = negative surface groups, orange = sodium ions, green = chloride ions. }}{11}{}\protected@file@percent }
